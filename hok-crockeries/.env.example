# Secret used to sign session JWTs. MUST be changed in production (min 32 chars).
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where the JSON database file is stored (relative to project root, or absolute).
DATA_DIR=".data"

# Seed credentials for the initial owner/admin account (used by `npm run seed`).
SEED_ADMIN_PHONE="01700000000"
SEED_ADMIN_PASSWORD="admin1234"
