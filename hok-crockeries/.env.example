# ── Required ──────────────────────────────────────────────────────────────────

# Signs session cookies. Must be a random string of at least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Postgres connection string. On Vercel, add a Neon database from the
# Storage tab and this is set for you. Any Postgres works.
DATABASE_URL=""


# ── Optional ──────────────────────────────────────────────────────────────────

# Where the embedded local database keeps its files. Only used when
# DATABASE_URL is empty (local development). Set to "memory://" for a
# throwaway database that disappears on restart.
# PGLITE_DIR=".data/pg"

# Allow the embedded database in production. Only for a single self-hosted
# server — it stores data in one directory on one machine, so it cannot work
# on Vercel or anywhere else that runs more than one instance.
# ALLOW_EMBEDDED_DB="1"

# Used by `npm run seed` for the demo workspace it creates.
# SEED_ORG_NAME="Hok Crockeries"
# SEED_ADMIN_EMAIL="owner@hokcrockeries.test"
# SEED_ADMIN_PASSWORD="owner12345"
# SEED_STAFF_PASSWORD="staff12345"
